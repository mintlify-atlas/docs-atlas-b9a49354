  "keyFeatures": [
    "Runtime unit conversion between hundreds of units",
    "String-to-unit and unit-to-string conversions",
    "Compact 8-byte unit representation covering all SI base units",
    "Measurement types with arithmetic operations and uncertainty propagation",
    "User-defined units and commodities support",
    "Domain-specific string interpretation (e.g., Nuclear, Astronomy, UCUM)",
    "Per-unit and equation-type units for power systems",
    "Python wrapper available via PyPI (units-llnl)",
    "Header-only mode and compiled mode with string support",
    "C++20 module support"
  ],
